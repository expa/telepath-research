{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "types": ["vite/client"],
    "paths": { "@/*": ["./*"] }
  },
  "include": ["app.tsx", "pages", "transitions", "components", "content", "lib", "vite.config.ts", "modulato.config.ts"],
  "exclude": ["node_modules", "lib/*.mjs"]
}
